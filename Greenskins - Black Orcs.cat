              <selectionEntries>
                <selectionEntry name="Proven Warrior" id="93e4-9cf7-f12b-f433" hidden="true" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a433-9939-2c93-2566" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <modifiers>
                    <modifier field="hidden" type="set" value="false">
                      <conditions>
                        <condition childId="d769-0d85-e810-df60" field="selections" includeChildSelections="true" scope="25d7-ef82-3f95-ae09" shared="true" type="atLeast" value="25"/>
                        <condition childId="f837-5be9-7764-4a23" field="selections" scope="25d7-ef82-3f95-ae09" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule name="Proven Warrior" id="44af-6a3e-6871-c87c" hidden="false">
                      <description>This young warrior has proven himself worthy of his Black Orc heritage.
This skill may only be taken by a Young’un with the Black Orc blood ability and 25 experience.


Once he gains this skill, the model is now considered a full Black Orc Warrior (yet still retains the title of Young’un).


He follows all the rules for Black Orcs and uses their equipment list and has access to the same skill lists as a Black Orc.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </entryLink>
          </entryLinks>
        </selectionEntry>
        <selectionEntry name="Black Orc Blood" id="f837-5be9-7764-4a23" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ef1c-a353-eee3-dad2" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="28fb-caa-69a4-56" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="Black Orc Blood" id="bc8f-d7e3-3ee7-fd8c" hidden="false">
              <description>One Young’un may be upgraded to a Black Orc Young’un for 10gc.
This upgrade allows him to take the ‘Proven Warrior’ skill upgrade, thus making him a fully-fledged Black Orc Warrior.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
