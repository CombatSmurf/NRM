      <rules>
        <rule name="Uncommon" id="b21b-57a0-1249-e55e" hidden="false">
          <description>A warband may not hire more Shootaz than they have Boyz.


If a boy dies and the Shootaz outnumber the Boyz, the next hire must be a boy so that the balance is restored.</description>
        </rule>
      </rules>
