<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Mercenaries - Ostermarkers (1b)" id="c315-31da-1718-4dde" battleScribeVersion="2.03" gameSystemId="9481a749-7900-614b-1695-bdc2899069c1" gameSystemRevision="15" library="false" revision="9" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
