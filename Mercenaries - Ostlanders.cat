  <publications>
    <publication name="Ostlanders Rules" id="42ce-e25d-7713-b46b" publisher="https://broheim.net/downloads/warbands/official/Ostlanders.pdf" publisherUrl="https://broheim.net/downloads/warbands/official/Ostlanders.pdf" shortName="Ostlanders"/>
  </publications>
  <rules>
    <rule name="Self Sufficient" id="0057-7432-79ff-2878" hidden="false">
      <description>The men of Ostland have no desire to give their hard-earned gold to outsiders.
As a result they can never hire any Mercenaries except for Ogres (who are not an uncommon sight in Ostland).</description>
    </rule>
  </rules>
