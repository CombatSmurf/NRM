            <entryLink name="Special Skills (Night Goblins)" id="f8c0-ec72-18f7-1782" collective="false" hidden="false" import="true" sortIndex="3" targetId="414e-db1-4cc4-8ef0" type="selectionEntryGroup"/>
            <entryLink name="Academic Skills" id="230e-6766-8f69-b6fc" hidden="false" import="true" sortIndex="1" targetId="df9d-8724-d362-9d7c" type="selectionEntryGroup"/>
