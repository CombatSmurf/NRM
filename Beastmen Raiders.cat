      <rules>
        <rule name="Bloodgreed" id="b3e8-779d-e585-61a9" hidden="false">
          <description>If a Minotaur puts all of its enemies out of action in hand-to-hand combat, it becomes frenzied on a D6 roll of 4+.</description>
        </rule>
        <rule name="Animal" id="0193-ec92-d9ff-6d73" hidden="false">
          <description>A Minotaur is far more bestial than its Beastmen brethren and, although it may gain Experience, it may never become a Hero.</description>
        </rule>
      </rules>
