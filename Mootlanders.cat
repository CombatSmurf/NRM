      <rules>
        <rule name="Inspired Cooking" id="e8e5-ad04-433d-13b6" hidden="false">
          <description>Any Halfling models within 6&quot; of a Halfling Master Chef may re-roll any failed hits in combat (once per turn).</description>
        </rule>
