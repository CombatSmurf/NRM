  <sharedSelectionEntries>
    <selectionEntry name="Cooking Pot Helmet" id="e958-4b33-a85d-664b" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="8"/>
        <cost name="Warband Rating" typeId="wb-rating" value="0"/>
      </costs>
      <profiles>
        <profile name="Cooking Pot Helmet" id="103c-1f8c-c97-cb2" hidden="false" typeId="94239014-ea28-23eb-4142-f492dc4caf17" typeName="Armor">
          <characteristics>
            <characteristic name="Armor Save" typeId="26f1ea4e-6017-a8fa-db2b-5c2a83aea46b"/>
            <characteristic name="Special" typeId="ff797ec4-8d7e-cab1-656e-896ae3ed005f">Halfling Avoid Stun</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Halfling Avoid Stun" id="9b2a-ea61-4efa-8943" hidden="false">
          <description>A Master Chef equipped with a Cooking Pot has a special save of 5+ against being stunned.


This save is never modified.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Ladle" id="8a4d-10a1-21f4-8adc" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="2"/>
        <cost name="Warband Rating" typeId="wb-rating" value="0"/>
      </costs>
      <profiles>
        <profile name="Ladle" id="4402-8df9-86e1-fda5" hidden="false" typeId="9db87680-6ee5-b46c-48ca-dcd1c5de1bad" typeName="HtH Weapon">
          <characteristics>
            <characteristic name="Str" typeId="f10cfcb7-b71e-4c27-9836-75d341e28f68">-1</characteristic>
            <characteristic name="Special" typeId="80dd3fd5-3811-af0b-e182-2ecbc7ad5d8e">No save except shields/skills, Knuckle Cracking</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Knuckle Cracking" id="9789-5671-cac6-2c20" hidden="false">
          <description>If a Master Chef manages to hit an enemy in close combat (a feat within itself) and scores a ‘6’ in doing so he has rapped his enemy across the knuckles and forced him to drop his weapon.</description>
        </rule>
        <rule name="No Save" id="c591-b424-eeeb-7f42" hidden="false">
          <description>A Master Chef knows exactly where to aim his ladle, helmets and breast plates are of little use against a ladle whacked across the hands.


The only saving throws allowed are from shields or skills.</description>
        </rule>
      </rules>
    </selectionEntry>
  </sharedSelectionEntries>
