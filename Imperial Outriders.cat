        <selectionEntry name="Ride" id="9d4c-b110-bef7-ed0e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a3c0-b45f-7261-6626-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="a3c0-b45f-7261-6626-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="Ride" id="c474-bed3-5e4-34cf" hidden="false">
              <description>This skill is vital if a rider wishes to ride an animal into combat.
The skill is specific to a particular type of animal and must be gained again if the warrior wishes to be able to ride a
different kind of animal.


For instance, a warrior with Ride Horse would need to gain the skill Ride Warhorse if he wanted to be able to ride such a spirited mount.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
