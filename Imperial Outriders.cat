        <selectionEntry name="Ride" id="515f-f25a-d5c3-e7cd" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4c71-e85f-f42a-9a36-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="4c71-e85f-f42a-9a36-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="Ride" id="dbad-1c47-a752-ca5c" hidden="false">
              <description>This skill is vital if a rider wishes to ride an animal into combat.
The skill is specific to a particular type of animal and must be gained again if the warrior wishes to be able to ride a
different kind of animal.


For instance, a warrior with Ride Horse would need to gain the skill Ride Warhorse if he wanted to be able to ride such a spirited mount.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
