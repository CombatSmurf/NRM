        <selectionEntry name="Ride" id="169c-123b-eda-74ef" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c75-9ead-bfbb-ecd1-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="9c75-9ead-bfbb-ecd1-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="Ride" id="eeee-3332-6e2-881b" hidden="false">
              <description>This skill is vital if a rider wishes to ride an animal into combat.
The skill is specific to a particular type of animal and must be gained again if the warrior wishes to be able to ride a
different kind of animal.


For instance, a warrior with Ride Horse would need to gain the skill Ride Warhorse if he wanted to be able to ride such a spirited mount.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
