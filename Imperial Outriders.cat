          </entryLinks>
        </selectionEntry>
        <selectionEntry name="Ride" id="2aed-4bef-6fd0-dee" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="360d-b406-8818-915-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="360d-b406-8818-915-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <rules>
            <rule name="Ride" id="1e82-b997-b062-5c7c" hidden="false">
              <description>This skill is vital if a rider wishes to ride an animal into combat.
The skill is specific to a particular type of animal and must be gained again if the warrior wishes to be able to ride a
different kind of animal.


For instance, a warrior with Ride Horse would need to gain the skill Ride Warhorse if he wanted to be able to ride such a spirited mount.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
