      <rules>
        <rule name="Lightning Reflexes" id="76b-4b31-95dc-67f7" hidden="false">
          <description>If the Knights Vanguard is charged he will ‘strike first’ against those that charged that turn.
As the charger(s) will also normally ‘strike first’ (for charging), the order of attack between the charger(s) and the Knights Vanguard will be determined by comparing Initiative values.</description>
        </rule>
        <rule name="Ride Warhorse" id="d8bb-7436-c23c-f597" hidden="false">
          <description>The Knights Vanguard is trained in riding Warhorses.</description>
        </rule>
      </rules>
