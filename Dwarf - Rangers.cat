      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Hand-to-hand Weapons" id="9dec-fd2a-1b5a-b381" flatten="true" hidden="false">
          <constraints>
            <constraint id="15f4-8590-99a0-b097" field="selections" scope="parent" shared="true" type="max" value="2"/>
          </constraints>
          <entryLinks>
            <entryLink name="Free Dagger" id="f23e-fc94-d5e2-9204" hidden="false" import="true" targetId="0d0b-ed37-d8b0-4cbf" type="selectionEntry"/>
            <entryLink name="Dagger" id="b1d3-3d4-7a51-be34" hidden="false" import="true" targetId="64e0-0bb6-542b-4beb" type="selectionEntry"/>
            <entryLink name="Club/Hammer/Mace/Staff" id="50d2-bdc6-2dc0-fdcf" hidden="false" import="true" targetId="cfcc-39fd-aeb4-876a" type="selectionEntry">
              <modifiers>
                <modifier field="name" type="set" value="Mace, Hammer"/>
              </modifiers>
            </entryLink>
            <entryLink name="Sword" id="6c98-9ba-48e7-df91" hidden="false" import="true" targetId="34fd-d6a3-50ee-ee06" type="selectionEntry"/>
            <entryLink name="DH Axe" id="a0f4-8a91-b2df-39c2" hidden="false" import="true" targetId="4002-4e79-75d0-3065" type="selectionEntry"/>
            <entryLink name="Axe" id="1c68-d1cc-7e5e-4442" hidden="false" import="true" targetId="5d01-06b9-3a86-73c9" type="selectionEntry">
              <modifiers>
                <modifier field="name" type="set" value="Battleaxe"/>
              </modifiers>
            </entryLink>
            <entryLink name="Spear" id="ea9b-ae8-14db-a113" hidden="false" import="true" targetId="005e-e397-8108-f198" type="selectionEntry"/>
            <entryLink name="Dwarf Axe" id="7ac7-af25-cb4c-909b" hidden="false" import="true" targetId="5208-f70c-664-e36e" type="selectionEntry"/>
            <entryLink name="Halberd" id="af40-e65f-cf91-374c" hidden="false" import="true" targetId="3c52-9e92-25ec-1939" type="selectionEntry"/>
            <entryLink name="DH Club/Hammer/Mace" id="a61d-ebcf-3cf4-6aba" hidden="false" import="true" targetId="c2e5-75e2-4a8e-2eb7" type="selectionEntry"/>
          </entryLinks>
          <modifiers>
            <modifier field="15f4-8590-99a0-b097" type="set" value="3">
