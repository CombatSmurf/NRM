              <modifiers>
                <modifier field="name" type="set" value="Mace, Hammer"/>
              </modifiers>
            </entryLink>
            <entryLink name="Sword" id="7c3e-6bf6-78d1-bf06" hidden="false" import="true" targetId="34fd-d6a3-50ee-ee06" type="selectionEntry">
              <modifiers>
                <modifier field="points" type="set" value="5"/>
              </modifiers>
            </entryLink>
            <entryLink name="Axe" id="6e88-9e55-48f1-f9f4" hidden="false" import="true" targetId="5d01-06b9-3a86-73c9" type="selectionEntry">
              <modifiers>
                <modifier field="name" type="set" value="Battleaxe"/>
              </modifiers>
            </entryLink>
          </entryLinks>
          <modifiers>
            <modifier field="7286-1e5b-2c80-5924" type="set" value="3">
              <conditions>
                <condition childId="0d0b-ed37-d8b0-4cbf" field="selections" scope="parent" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Starting Gromril weapons" id="5cef-476f-4e24-b0e6" hidden="false">
              <description>Any weapon a Dwarf may normally purchase may be purchased as a Gromril weapon instead.
This multiplies the cost of the weapon by three.


Note that this price is only for a starting warband, as it represents the Dwarfs outfitting themselves at their own stronghold.


Later purchases of Gromril weapons are done using the Price Charts in the Mordheim rulebook.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Armor" id="337d-3438-261d-a99a" flatten="true" hidden="false">
          <entryLinks>
            <entryLink name="Light Armor" id="bc4f-e83-34a5-91c1" hidden="false" import="true" targetId="3d2a-426a-c350-2a03" type="selectionEntry"/>
            <entryLink name="Heavy Armor" id="f70f-d546-cfa-34ba" hidden="false" import="true" targetId="4e34-bbc5-c7ef-6bd6" type="selectionEntry"/>
