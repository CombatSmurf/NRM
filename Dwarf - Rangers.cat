        </selectionEntryGroup>
        <selectionEntryGroup name="Armor" id="a789-83f8-6600-f498" flatten="true" hidden="false">
          <entryLinks>
            <entryLink name="Light Armor" id="926a-36b9-ae54-f23f" hidden="false" import="true" targetId="3d2a-426a-c350-2a03" type="selectionEntry"/>
            <entryLink name="Heavy Armor" id="60f5-4828-3bcb-8d5b" hidden="false" import="true" targetId="4e34-bbc5-c7ef-6bd6" type="selectionEntry"/>
            <entryLink name="Shield" id="555c-8074-9d14-4dcd" hidden="false" import="true" targetId="74fb-cc90-1361-df26" type="selectionEntry"/>
            <entryLink name="Helmet" id="5a1a-a7b0-8e0f-fbda" hidden="false" import="true" targetId="d0e5-ca89-5f0d-f5d2" type="selectionEntry"/>
            <entryLink name="Gromril Armour" id="3b5c-88c7-75-4b77" hidden="false" import="true" targetId="4c6d-eb92-53a7-a6d3" type="selectionEntry"/>
          </entryLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5fb3-d52e-955d-ea74" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Starting Gromril Armor" id="c50b-2b0e-b556-5d4a" hidden="false">
              <description>The price of a suit of Gromril armour is cheaper for a starter warband to represent the relative ease with which Dwarfs can find such items in their own stronghold.


Later purchases of Gromril Armour must be done using the normal Price Chart in the Mordheim rulebook.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Missile weapons" id="d8bb-1e39-978-c09f" flatten="true" hidden="false">
          <constraints>
