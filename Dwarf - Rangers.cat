      <selectionEntryGroups>
        <selectionEntryGroup name="Hand-to-hand Weapons" id="a0cf-14e7-c569-55ad" flatten="true" hidden="false">
          <constraints>
            <constraint id="7286-1e5b-2c80-5924" field="selections" scope="parent" shared="true" type="max" value="2"/>
          </constraints>
          <entryLinks>
            <entryLink name="Free Dagger" id="d040-797a-8497-943d" hidden="false" import="true" targetId="0d0b-ed37-d8b0-4cbf" type="selectionEntry"/>
