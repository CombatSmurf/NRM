<catalogue name="Amazons Mordheim (1b)" id="7f2c-337f-3ebd-2263" battleScribeVersion="2.03" gameSystemId="9481a749-7900-614b-1695-bdc2899069c1" gameSystemRevision="15" library="false" revision="7" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink name="common-data" id="0e0e-c62d-8529-8edb" importRootEntries="true" targetId="e020-c282-277b-b173" type="catalogue"/>
    <catalogueLink name="Characters" id="4245-2ce6-7a07-decb" importRootEntries="true" targetId="9bf78c55-7dba-4a44-90ce-10ed57d8b3a1" type="catalogue"/>
