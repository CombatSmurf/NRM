<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Tomb Guardians (1b)" id="7d2b-89ab-a974-f328" battleScribeVersion="2.03" gameSystemId="9481a749-7900-614b-1695-bdc2899069c1" gameSystemRevision="15" library="false" revision="5" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
