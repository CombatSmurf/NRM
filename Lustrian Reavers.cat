          <entryLinks>
            <entryLink name="Lesser Magic" id="e7b3-5a8a-988a-1fa1" hidden="false" import="true" targetId="c81b-0f96-fcce-222d" type="selectionEntryGroup"/>
          </entryLinks>
          <rules>
            <rule name="Wizard" id="14b9-2979-c601-cf9e" hidden="false">
              <description>At the cost of +30 Gold Crowns you can make Jungle Shadow a Wizard.
Jungle Shadow uses the Lesser Magic list.
Generate a single Spell as standard for a wizard.
If you make the Jungle Shadow a Wizard, remove the Light Armour from the equipment list when starting out, and generate 1 Lesser Magic spell they can use.</description>
            </rule>
          </rules>
        </selectionEntry>
