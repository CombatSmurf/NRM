                    <characteristic name="T" id="84a6-2e6b-7635-db7a" hidden="false" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">3</characteristic>
                    <characteristic name="W" id="8fcf-ae94-209e-8865" hidden="false" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">1</characteristic>
