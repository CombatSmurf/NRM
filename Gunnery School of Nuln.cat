      <rules>
        <rule name="Leader" id="4296-3434-3d04-ab65" hidden="false">
          <description>Any models in the warband within 12” of the Senior Gunnery Officer may use his Leadership value when using Leadership tests.</description>
        </rule>
      </rules>
