      <rules>
        <rule name="Drunk" id="491a-8ca2-94db-8782" hidden="false">
          <description>The militia are blasted out of their tiny minds on Rotfire moonshine and cheap ale.
As such, they automatically pass all Leadership-based tests they are required to take.</description>
        </rule>
