      <rules>
        <rule name="Utterly Inept" id="91ee-2a76-71de-2a8f" hidden="false">
          <description>Gutterscum have turned to a life of crime because they lack the ability to fit into normal society.


They lack both the ambition and the capacity for self improvement.


Gutterscum do not gain experience.</description>
        </rule>
      </rules>
