      <rules>
        <rule name="Disclaimer" id="319e-bc36-699f-b95e" hidden="false">
          <description>In the published warband rules it is stated that the Bandit Prince has access to Bandit Heroes Equipment lists (this IMHO means all bandit heroes Equip), if you only want the regular Bandit equipment list do not consider the equip with a *</description>
        </rule>
      </rules>
