            <rule name="Sign of Sigmar" id="ec0201c9-9adc-5e88-1532-5e06d7cd4dc5" hidden="false" page="0">
              <description>Possessed or Undead opponents lose their first attack against the Priestess in the first round of hand-to-hand combat (down to a minimum of 1).</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Protection of Sigmar" id="82ca453a-2d7c-76a8-af4e-7e43b98884b3" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="d075-a452-ca83-7ff1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="Protection of Sigmar" id="caeebfd9-74a7-e01f-681d-6490ac18c2b1" hidden="false" page="0">
              <description>Any spell which would affect her is nullified on a D6 roll of 4+. Note that if the spell is nullified it will not affect any other models either.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Righteous Fury" id="c89534fb-ea6a-4c3e-fd07-b170c27c8127" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="d08d-614d-5540-54f0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Hatred" id="29df0a96-5407-9720-dc50-48203c1213fb" hidden="false" targetId="fcb5-1485-5135-40ff" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Righteous Fury" id="8a9e35b9-8177-5fb7-398f-27e5334e2f93" hidden="false" page="0">
              <description>The model hates all Skaven, Undead or Possessed warbands and all models in them.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Absolute Faith" id="81e79a9d-28af-bac2-be55-b8ed2f950f34" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="5053-3fb6-7d9c-e124" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
