            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="Absolute Faith" id="0fbdda54-9bea-b5cb-e0ca-dfaaefc0554e" hidden="false" page="0">
              <description>She may re-roll any Fear tests and does not have to test if she is fighting alone against several opponents.</description>
            </rule>
          </rules>
