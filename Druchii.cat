      <rules>
        <rule name="Slavehounds" id="8098-6b8e-81bd-7c87" hidden="false">
          <description>The Beastmaster may be accompanied by up to three Slavehounds. These are bought as henchmen and follow all rules listed for them.</description>
        </rule>
