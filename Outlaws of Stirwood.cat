          </constraints>
          <entryLinks>
            <entryLink name="Bow" id="b320-b7a1-2cf1-33b3" hidden="false" import="true" targetId="311a-bf3f-67ff-46e7" type="selectionEntry"/>
            <entryLink name="Longbow" id="7ca0-4a80-bee0-a9dc" hidden="true" import="true" targetId="afa2-2d5c-54dd-d435" type="selectionEntry">
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="e535-8337-60b5-994d" field="selections" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </entryLink>
            <entryLink name="Shortbow" id="8662-8df4-2e47-6d5e" hidden="false" import="true" targetId="3706-6421-53b4-940d" type="selectionEntry"/>
          </entryLinks>
          <rules>
            <rule name="Disclaimer" id="df0e-55f6-c8f4-a753" hidden="false">
              <description>Normally everyone in a outlaws warband must have a bow of some kind, but since there are many house rules that limit the use of missile weapons one way or another I&apos;ve chosen not to enforce this rule.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Armor" id="f031-1852-790a-8382" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="Light Armor" id="d106-bd22-82ae-3d5c" hidden="true" import="true" targetId="3d2a-426a-c350-2a03" type="selectionEntry">
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="a0fce0bc-02e0-a064-7a39-5b97ff8a9c94" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="e535-8337-60b5-994d" field="selections" scope="parent" shared="true" type="instanceOf" value="1"/>
                      </conditions>
