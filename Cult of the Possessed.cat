        <selectionEntry name="Blackblood" id="bc9a00f5-f67a-d480-cf6a-3b84090eb3fd" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="BlackBlood" id="a9a369c7-50d9-03e6-602f-9e2d4cc87a93" hidden="false">
              <description>If the model loses a wound in close combat, anyone in base contact with the model suffers a Strength 3 hit (no critical hits) from the spurting corrosive blood.</description>
