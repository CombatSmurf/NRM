          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="Spines" id="bd85a204-0692-6d2b-25a3-1f84c5e11470" hidden="false">
