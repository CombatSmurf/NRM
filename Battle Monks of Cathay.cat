      <rules>
        <rule name="Ride Horse" id="97cc-9953-45f5-dff3" hidden="false">
          <description>The Emissary is trained in riding Horses.</description>
        </rule>
        <rule name="Decree" id="3948-4c3a-826d-54a8" hidden="false">
          <description>When the Emissary dies, a new one must be hired as soon as possible.
Until you have done so, no other warriors and/or equipment may be bought.
The new Emissary will then reclaim Leadership of the warband.</description>
        </rule>
      </rules>
