            <characteristic name="LD" id="30b1-728d-b469-afb1" hidden="false" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">6</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Improvised Weapons" id="9824-771e-57dd-e84b" hidden="false">
          <description>A peasant is usually equipped with a pitchfork, torch or other simple tool.
Treat them as fighting unarmed but without any penalties.</description>
        </rule>
        <rule name="Simple Folk" id="7bff-86ab-8576-4b6e" hidden="false">
          <description>Peasants never gain Experience.</description>
        </rule>
        <rule name="Mob" id="3983-874c-c7bc-d129" hidden="false">
          <description>Peasants become threatening in large numbers.


A Peasant gets +1 Ld for each other allied Peasant model within 3&quot;.
Due to their rage they do not benefit from the leader rule.</description>
        </rule>
        <rule name="Ignored" id="f0f4-b8e2-6f31-4835" hidden="false">
          <description>Peasants that are out of action do not count to the number of out of action models for the purpose of Rout tests.</description>
        </rule>
        <rule name="Downtrodden" id="51bd-8995-6a6e-7a05" hidden="false">
          <description>When a Peasant is wounded do not roll for injury.


The model is immediately taken out of action.</description>
        </rule>
      </rules>
