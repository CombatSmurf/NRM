            <entryLink name="Special Skills (Shadow Warrior)" id="b1a4334a-194d-229c-6ba5-7ff7c7319378" collective="false" hidden="false" import="true" targetId="285ebcd1-3b2e-4937-39bc-a88721067dca" type="selectionEntryGroup"/>
          </entryLinks>
          <selectionEntryGroups>
            <selectionEntryGroup name="Strength Skills (only with Powerful build skill)" id="7238c427-6c7e-f37d-8a77-73acf14ada3a" collective="false" hidden="false" import="true">
              <selectionEntries>
                <selectionEntry name="Mighty Blow" id="ca57804c-dc5d-ef51-7654-c004a6cbbc82" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Mighty Blow" id="4241b83c-2f1a-019d-78a4-792f268faea4" hidden="false" page="0">
                      <description>The warrior knows how to use his strength to maximum effect and has a +1 Strength bonus in close combat (excluding pistols). As his
Strength is used for close combat weapons, the bonus applies to all such weapons.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Pit Fighter" id="15eb871e-6a2a-6ed0-4b05-dad3a29cd126" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Pit Fighter" id="4812e629-a542-e0ff-3edf-a807b1a0773d" hidden="false" page="0">
                      <description>The warrior has learned how to fight in enclosed spaces from his time in the dangerous fighting pits of the Empire. He is an expert at fighting in confined areas and adds +1 to his WS and +1 to his Attacks if he is fighting inside buildings or ruins.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Resilient" id="b6175506-41cf-ecee-327b-b6fc3ba68316" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Resilient" id="20d3ff44-676d-e416-1b1b-99a54bd2af24" hidden="false" page="0">
                      <description>Deduct -1 Strength from all hits against him in close combat. This does not affect armour save modifiers</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Fearsome" id="aa7cdeb9-4567-73b5-a419-e36147184461" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Fearsome" id="49745af0-992c-90d3-62fc-8ba807fbbda1" hidden="false" page="0">
                      <description>The model that he causes fear in opposing models</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Strongman" id="b029e595-f9cb-314f-2095-edb35f44d7d8" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Strongman" id="29ed13db-686e-51e6-b716-e52779bc8f63" hidden="false" page="0">
                      <description>He may use a double-handed weapon without the usual penalty of always striking last. Work out order of battle as you would with other weapons</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Unstoppable Charge" id="ecd2b4e7-a5d2-c943-0532-87bcaae48a56" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Unstoppable Charge" id="6082653c-ccc1-6800-7631-fbea1cb56fc2" hidden="false" page="0">
                      <description>When he charges, the warrior is almost impossible to halt. He adds +1 to his Weapon Skill when charging.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
