            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Shooting Skills" id="17612618-33cb-0ad5-6325-cdb50c7f936f" collective="false" hidden="false" import="true" targetId="0073-d2d6-15c0-45b1" type="selectionEntryGroup"/>
