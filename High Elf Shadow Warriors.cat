          </costs>
          <entryLinks>
            <entryLink name="Shooting Skills" id="17612618-33cb-0ad5-6325-cdb50c7f936f" collective="false" hidden="false" import="true" targetId="52007ee0-cc99-b312-3650-cfab391e476c" type="selectionEntryGroup"/>
            <entryLink name="Combat Skills" id="b730009d-1a25-5605-9c34-f59b2da1cb69" collective="false" hidden="false" import="true" targetId="bd8689c9-bc5c-df7b-87b9-aad34e27a295" type="selectionEntryGroup"/>
            <entryLink name="Speed Skills" id="9a2384e1-c454-d434-2f2c-8a881c7ebacb" collective="false" hidden="false" import="true" targetId="2a62fe9a-16ae-b087-f5a5-47f19da37c89" type="selectionEntryGroup"/>
            <entryLink name="Special Skills (Shadow Warrior)" id="56a33589-9173-8a8c-1b0a-ed7c4461fdd9" collective="false" hidden="false" import="true" targetId="285ebcd1-3b2e-4937-39bc-a88721067dca" type="selectionEntryGroup"/>
          </entryLinks>
          <selectionEntryGroups>
            <selectionEntryGroup name="Strength Skills (only with Powerful build skill)" id="46418e2d-9527-1f04-56ea-dd40f645fdd7" collective="false" hidden="false" import="true">
              <selectionEntries>
                <selectionEntry name="Mighty Blow" id="ca815c66-ef57-7279-c83e-0278c3c51e56" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Mighty Blow" id="7f7024dc-3313-6218-981e-77f88e13173c" hidden="false" page="0">
                      <description>The warrior knows how to use his strength to maximum effect and has a +1 Strength bonus in close combat (excluding pistols). As his
Strength is used for close combat weapons, the bonus applies to all such weapons.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Pit Fighter" id="a51b1363-6b17-9d11-51dd-f1dae850608f" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Pit Fighter" id="2063d199-a54e-55d8-6a63-4525aaf39864" hidden="false" page="0">
                      <description>The warrior has learned how to fight in enclosed spaces from his time in the dangerous fighting pits of the Empire. He is an expert at fighting in confined areas and adds +1 to his WS and +1 to his Attacks if he is fighting inside buildings or ruins.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Resilient" id="addae651-3944-ee2d-3445-8a79cf7be625" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Resilient" id="899d11fc-d3a9-7025-e8e4-ddb4b130cadc" hidden="false" page="0">
                      <description>Deduct -1 Strength from all hits against him in close combat. This does not affect armour save modifiers</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Fearsome" id="0c2e2814-c6c5-5436-4683-3aa132dbde7e" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Fearsome" id="bc4de587-1ff4-1440-4360-f6a2497cfa35" hidden="false" page="0">
                      <description>The model that he causes fear in opposing models</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Strongman" id="55d2441e-021f-0b95-55d4-57546c0b4fa8" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Strongman" id="4589cae9-c538-2408-d165-c642682ced49" hidden="false" page="0">
                      <description>He may use a double-handed weapon without the usual penalty of always striking last. Work out order of battle as you would with other weapons</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Unstoppable Charge" id="1a0a5ba9-5ab3-cff0-d8e7-21861bec2f9a" collective="false" hidden="false" import="true" page="0" type="upgrade">
                  <constraints>
                    <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Warband Rating" typeId="wb-rating" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Unstoppable Charge" id="6994fd3a-76ff-d13b-6593-a979947a9f7a" hidden="false" page="0">
                      <description>When he charges, the warrior is almost impossible to halt. He adds +1 to his Weapon Skill when charging.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
