<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Shadow Warriors (1b)" id="a808d69a-88e2-9484-b24a-181ea44917e5" battleScribeVersion="2.03" gameSystemId="9481a749-7900-614b-1695-bdc2899069c1" gameSystemRevision="15" library="false" revision="15" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink name="Characters" id="2447-01ba-5309-c709" importRootEntries="true" targetId="9bf78c55-7dba-4a44-90ce-10ed57d8b3a1" type="catalogue"/>
    <catalogueLink name="common-data" id="b2f3-0ef9-a020-d184" importRootEntries="true" targetId="e020-c282-277b-b173" type="catalogue"/>
  </catalogueLinks>
  <infoLinks>
    <infoLink name="EXP advancement" id="5acdcee6-8115-9d89-26d7-1908b50dda55" hidden="false" targetId="525a-8370-3dd1-ff3d" type="rule"/>
    <infoLink name="Hatred" id="3a347076-4145-7a31-2e75-67112fcaaf2f" hidden="false" targetId="fcb5-1485-5135-40ff" type="rule"/>
  </infoLinks>
  <rules>
    <rule name="Hate Dark Elves" id="401d6f85-554c-c458-62d3-a8006a84ad9f" hidden="false">
      <description>All warriors in a Shadow Warrior Warband (excluding any Hired Swords) have an unyielding Hatred for Dark Elves.</description>
    </rule>
    <rule name="Excellent Sight" id="686e6055-5de2-59c2-667b-ef5bf3837815" hidden="false">
      <description>All the Elves in a
Shadow Warrior Warband can spot Hidden
enemies from twice as far away as other
warriors (i.e. twice their Initiative in inches).</description>
    </rule>
    <rule name="Distaste for Poison" id="3ea7d381-3866-14fb-9f7a-d9d1fe69c99a" hidden="false">
      <description>Warriors in
a Shadow Warrior Warband may not use
poisons of any type</description>
    </rule>
    <rule name="Unforgiving" id="7f31b2a1-f680-a8a7-59e6-5f2153703eba" hidden="false">
      <description>a Shadow Warrior warband may never forge an alliance
with any Warband of a Chaotic nature
(Possessed, Skaven, Beastmen, Dark Elves,
etc.).</description>
    </rule>
    <rule name="Tolerant" id="38bb39c5-bfc3-be0a-59c0-7fe2c58e8de8" hidden="false">
      <description>A Shadow Warrior Warband may hire any Hired Sword that is not of a Chaotic or evil bent (so no Skaven,Possessed, Beastmen, Dark Elves, Undead,etc.). They also shun the company of anyone specialising in the use of poison (so no Assassins).</description>
    </rule>
  </rules>
