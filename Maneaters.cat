      </profiles>
      <rules>
        <rule name="Bull Charge" id="0679-a234-580a-1afb" hidden="false">
          <description>Ogres learn to use their vast bulk in a charge, trampling the enemy to the ground.
When charging, Bulls may attempt a single attack with a +1 ‘to hit’ modifier rather than making their normal attacks.
If successful the enemy model is automatically knocked down.</description>
        </rule>
      </rules>
      <selectionEntries>
