            <characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">4</characteristic>
            <characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">0</characteristic>
            <characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">4</characteristic>
            <characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">4</characteristic>
            <characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">2</characteristic>
            <characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">4</characteristic>
            <characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">3</characteristic>
            <characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">4</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Trained" id="a6f0-e76b-9826-142c" hidden="false">
          <description>Sabretusks may use the Leadership of the Mountain Guide if within 6” of him.

In the event that no Mountain Guide is included in the warband due to a death or an injury, the Sabretusks cannot be used until the Mountain Guide is replaced.
They must be caged and left at the camp until a new one is hired.</description>
        </rule>
        <rule name="Feral Instinct" id="2a7c-a811-3d0a-df66" hidden="false">
          <description>Even a Guide has difficulty controlling such feral beasts.
At the beginning of the Ogres turn the Sabretusk must pass a Leadership test.
If the test is failed, the opponent may move the Sabretusk this turn.

An uncontrolled Sabretusk may charge models from his own warband!</description>
        </rule>
        <rule name="Ignored" id="0149-6332-1755-9c40" hidden="false">
          <description>Sabretusks that are out of action do not count to the number of out of action models for the purpose of Rout tests.</description>
        </rule>
      </rules>
    </selectionEntry>
