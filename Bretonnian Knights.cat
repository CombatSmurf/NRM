      <rules>
        <rule name="Knights Virtue" id="be98-b35c-f41a-9a8b" hidden="false">
          <description>A Knight Errant is a chivalrous warrior who is superior to ordinary warriors.
He will never panic and break from combat and so does not have to pass a Leadership test for being all alone.</description>
        </rule>
      </rules>
