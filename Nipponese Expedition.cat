  <rules>
    <rule name="May hire" id="bf33-83e8-2b14-98bc" hidden="false">
      <description>A Nippon warband is allowed the same selection of Hired Swords as Human Mercenary warbands</description>
    </rule>
    <rule name="Strategic Minded" id="8b10-eba9-122e-cff2" hidden="false">
      <description>A Nipponese warband must rely on its battlefield experience so far from home. They may choose to rout after suffering 1 fewer casualty than normal</description>
    </rule>
  </rules>
