                    <characteristic name="Str" typeId="f10cfcb7-b71e-4c27-9836-75d341e28f68">+1</characteristic>
                    <characteristic name="Special" typeId="80dd3fd5-3811-af0b-e182-2ecbc7ad5d8e">Parry, Improved Criticals</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Improved Criticals" id="cac7-7e17-4b2f-23b1" hidden="false">
                  <description>This sword causes a critical hit on a wound roll of 5 or 6.</description>
                </rule>
                <rule name="Ienh-Khain" id="5d34-2270-b341-7583" hidden="false">
                  <description>Ienh-Khain (the Hand of Khaine).
Ienh-Khain is an incredibly long singleedged sword, which Aenur uses with consummate skill.
This sword allows Aenur to parry; adds + 1 to his Strength and causes a critical hit on a roll of 5-6 when rolling to wound.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Skills" id="7287-8722-e1fa-fe48" collective="false" hidden="false" import="true" page="0" type="upgrade">
