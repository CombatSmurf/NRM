                <constraint id="8656-72e4-4588-068d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Quick Shot" id="7b96-2c3e-32be-12b1" hidden="false" page="0">
                  <description>The warrior may shoot twice per turn with a bow or crossbow (but not a crossbow pistol).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Knife Fighter" id="7826-2830-85fa-b9da" collective="false" hidden="false" import="true" page="0" type="upgrade">
              <constraints>
                <constraint id="301c-e81e-87d4-ce29" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="c567-7e82-3f2a-53f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Knife Fighter" id="54a2-4dec-2d8c-c64a" hidden="false" page="0">
                  <description>The warrior is an unrivalled expert at using throwing knives and throwing stars.
He can throw a maximum of three of these missiles in his shooting phase and may divide his shots between any targets within range as he wishes.
Note that this skill cannot be combined with the Quick Shot skill.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Veskit, High Executioner of Clan Eshin (1a)" id="cbd3-bfe0-c123-8863" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Dramatis Personae" id="450d-2caa-c391-48f8" hidden="false" primary="true" targetId="0aea-26b8-980b-28aa"/>
        <categoryLink name="Dramatis Personae" id="9abc-8c61-9640-eee6" hidden="false" primary="false" targetId="0aea-26b8-980b-28aa"/>
