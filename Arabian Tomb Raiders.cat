      <rules>
        <rule name="Life of Slavery" id="c6d7-4c16-3e7e-d145" hidden="false">
          <description>A Slave may gain experience but if he rolls Lad’s got Talent the leader executes the Slave and he is removed from the roster.
The rest of the group may then re-roll their advance.</description>
        </rule>
      </rules>
